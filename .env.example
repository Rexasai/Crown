# Salin file ini jadi ".env" lalu isi sesuai kebutuhan.

# Port server (biasanya di-set otomatis oleh hosting, boleh dikosongkan)
PORT=3000

# Ganti dengan teks acak/rahasia milikmu sendiri (buat keamanan token login)
JWT_SECRET=ganti-dengan-teks-rahasia-acak-punya-kamu

# Username (NAME, bukan Grow ID) akun yang otomatis jadi ADMIN PERTAMA
# saat server pertama kali dijalankan. Boleh lebih dari satu, pisahkan koma.
# Setelah admin pertama ini bisa menambah admin lain lewat menu Team Members.
BOOTSTRAP_ADMIN_USERNAME=NamaAdminKamu
